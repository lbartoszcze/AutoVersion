{
  "schema_version": 1,
  "product": "autoversion",
  "releases": true,
  "version_source": {
    "kind": "json",
    "path": "released-surface.json",
    "pointer": "/version"
  },
  "platforms": {
    "source": {
      "runner_platform": "linux-amd64",
      "quality": [{"name": "fmt", "argv": ["cargo", "fmt", "--all", "--", "--check"]}],
      "build": {
        "argv": ["stado", "product", "source-bundle"]
      },
      "stage": {
        "release/source-bundle.tar": "release/source-bundle.tar"
      }
    }
  },
  "promotion": {
    "channels": [
      "stable"
    ],
    "reconcile": false
  },
  "inputs": {},
  "deliveries": []
}
